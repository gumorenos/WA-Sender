COMPOSE_PROJECT_NAME=wa-sender

# Public hosts
DOMAIN=midominio.com
APP_HOST=app.midominio.com
EVOLUTION_HOST=evo.midominio.com
STATUS_HOST=status.midominio.com
CADDY_EMAIL=admin@midominio.com

# Optional image pins. Validate ARM64 availability before beta.
APP_IMAGE=wa-sender-app:beta
CADDY_IMAGE=caddy:2.8.4-alpine
POSTGRES_IMAGE=postgres:16.6-alpine
REDIS_IMAGE=redis:7.4.1-alpine
EVOLUTION_API_IMAGE=atendai/evolution-api:v2.1.1
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1.23.16

# App URLs
APP_URL=https://app.midominio.com
NEXT_PUBLIC_APP_URL=https://app.midominio.com
AUTH_URL=https://app.midominio.com
NEXTAUTH_URL=https://app.midominio.com
AUTH_TRUST_HOST=true

# Auth.js / Google OAuth. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-generated-secret
NEXTAUTH_SECRET=replace-with-same-value-as-auth-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Closed beta. Keep true until a real invitation/onboarding flow is intentionally released.
# Existing ACTIVE users may sign in; new Google accounts must be listed here.
BETA_REQUIRE_INVITE=true
BETA_ALLOWED_EMAILS=owner@midominio.com

# WA Sender PostgreSQL
POSTGRES_USER=wa_sender
POSTGRES_PASSWORD=replace-with-strong-app-db-password
POSTGRES_DB=wa_sender
DATABASE_URL=postgresql://wa_sender:replace-with-strong-app-db-password@postgres-app:5432/wa_sender

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
WORKER_ENABLED=true
WORKER_HEARTBEAT_KEY=wa-sender:worker:heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_STALE_SECONDS=120

# Tenant defaults
DEFAULT_PLAN_CODE=demo
DEFAULT_WORKSPACE_NAME=Mi workspace

# Technical safety limits for campaign creation. Plan limits are enforced separately.
CAMPAIGN_CREATE_MAX_BODY_BYTES=750000
CAMPAIGN_MAX_RAW_INPUT_BYTES=500000
CAMPAIGN_MAX_ROWS=1000

# Safe defaults for beta until real sending is deliberately enabled.
REAL_SENDING_ENABLED=false
EVOLUTION_MOCK=false
MOCK_WHATSAPP_ENABLED=false
MOCK_LLM_ENABLED=true
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GROQ_API_KEY=

# Evolution API internal config
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-strong-evolution-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-strong-webhook-secret
EVOLUTION_TIMEOUT_MS=8000

# Agent safety: assignment alone never activates replies. Enable deliberately and independently.
AGENT_AUTOREPLY_ENABLED=false
AGENT_REAL_REPLY_ENABLED=false
AGENT_DEFAULT_TIMEZONE=America/Lima
AGENT_IGNORE_GROUPS=true
AGENT_REPLY_RATE_LIMIT_SECONDS=60
AGENT_LLM_CIRCUIT_BREAKER_THRESHOLD=3
AGENT_LLM_CIRCUIT_BREAKER_WINDOW_MINUTES=10
AGENT_WEBHOOK_MAX_MESSAGE_CHARS=1200
AGENT_OPT_OUT_CONFIRMATION=Confirmamos que no recibiras mas mensajes automaticos. Si necesitas ayuda, escribe a un asesor humano.
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=replace-with-strong-evolution-db-password
EVOLUTION_POSTGRES_DB=evolution

# Caddy protection for the optional Evolution admin hostname.
# Generate hash with:
# docker compose run --rm caddy caddy hash-password --plaintext 'replace-with-admin-password'
EVOLUTION_ADMIN_USER=admin
EVOLUTION_ADMIN_PASSWORD_HASH=replace-with-caddy-bcrypt-hash

# Backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RUN_ON_START=true
BACKUP_CLEANUP_LOGS=true
BACKUP_LOG_RETENTION_DAYS=90
# Optional external local mount. For Object Storage, mount it on the host with rclone/s3fs
# and point this path to that mount.
BACKUP_EXTERNAL_PATH=./backups-external

# Ops
LOG_LEVEL=info
# Required for /api/health/deep. Keep private; never expose as NEXT_PUBLIC_*.
HEALTHCHECK_TOKEN=replace-with-healthcheck-token
